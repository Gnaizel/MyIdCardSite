# Caddy сам получает сертификат Let's Encrypt на каждое имя, сам их
# продлевает и сам редиректит http -> https. Никакого certbot и cron.
# Список имён и почта берутся из .env (SITE_DOMAINS, ACME_EMAIL).
{
	# Почта, на которую Let's Encrypt напишет, если продление сломается.
	# Кавычки обязательны: без них пустой ACME_EMAIL разворачивается в
	# "email" без аргумента, и Caddy не стартует вообще. С кавычками
	# пустое значение просто означает "без почты" — сертификат всё равно
	# выпустится, только писем не будет.
	email "{$ACME_EMAIL}"
}

# Все имена одним блоком, через запятую. Сертификат Caddy возьмёт на каждое
# отдельно, так что домены можно добавлять и убирать по одному.
{$SITE_DOMAINS} {
	# Весь http-трафик на эти имена Caddy редиректит на https сам, 308-м.

	encode zstd gzip

	header {
		# Год: браузер, один раз побывав здесь, больше не пойдёт по http вообще.
		# includeSubDomains намеренно нет — иначе будущий поддомен без TLS
		# окажется недоступен, и до года это не откатить.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Версию сервера наружу не отдаём.
		-Server
	}

	# www уводим на апекс тем же блоком, а не отдельным: отдельный пришлось
	# бы вести списком руками, и он ломался бы, стоило завести домен без
	# www-записи. labels нумеруются справа, поэтому для www.sponj.online
	# labels.1 = sponj, labels.0 = online — правило работает с любым
	# доменом из списка, ничего не зная про него заранее.
	@www expression {host}.startsWith("www.")
	redir @www https://{labels.1}.{labels.0}{uri} permanent

	# Actuator приезжает вместе со spring-boot-starter-actuator и наружу не нужен.
	@internal path /actuator /actuator/*
	respond @internal 404

	# X-Forwarded-For Caddy проставляет сам и чужой заголовок затирает, а не
	# дописывает к нему свой: подделать адрес клиент не может. Это важно —
	# гостевая книга берёт из списка первый адрес и считает по нему лимиты.
	# Ломается это только если задать глобальный trusted_proxies: тогда
	# заголовку клиента начнут верить.
	reverse_proxy my-site:8080
}
