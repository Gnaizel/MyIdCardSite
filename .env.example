# Скопируй этот файл в .env и впиши свои ключи.
# .env лежит в .gitignore, так что наружу они не уедут.
# Где что брать — написано в README-LOCAL.md.

# https://www.last.fm/api/account/create
LASTFM_API_TOKEN=

# https://steamcommunity.com/dev/apikey
STEAM_API_TOKEN=
# SteamID64 — 17 цифр, узнать можно на https://steamid.io
# Аккаунтов можно перечислить сколько угодно через запятую: часы и библиотеки
# сложатся, одна и та же игра на двух аккаунтах не задвоится.
# Один ключ выше работает со всеми: он выдаётся разработчику, а не профилю.
STEAM_IDS=

# Статистика Fortnite. У Epic нет API для библиотеки целиком — это
# подтверждал их сотрудник на форуме, — но по отдельной игре она есть.
# Ключ бесплатный: https://dash.fortnite-api.com/
FORTNITE_API_KEY=
# Ник в Epic. Статистика должна быть открыта в самой игре:
# Career -> приватность -> показывать в таблице лидеров.
FORTNITE_NAME=

# https://github.com/settings/tokens — classic, право read:user
GITHUB_TOKEN=
GITHUB_LOGIN=Gnaizel

# Любая длинная случайная строка. Нужна, только чтобы модерировать
# гостевую книгу. Пустая — админские ручки просто закрыты.
GUESTBOOK_ADMIN_KEY=

# Бот, который присылает в телеграм всё, что пишут в гостевую книгу.
# Токен берётся у @BotFather.
TELEGRAM_BOT_TOKEN=
# Кому слать: напиши боту любое сообщение и возьми chat.id из
# https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_CHAT_ID=

# Репосты из TikTok в блоке слева. Пустой ник — блока просто нет.
TIKTOK_USERNAME=
# secUid — внутренний идентификатор профиля, не ник. Открой
# https://www.tiktok.com/@<ник>, в исходнике страницы найди
# __UNIVERSAL_DATA_FOR_REHYDRATION__ и внутри него поле secUid.
TIKTOK_SEC_UID=

# Во что играю прямо сейчас — для игр, которых нет в Steam.
#
# У Riot живого статуса для Valorant нет ни в каком открытом виде, поэтому
# берём его у Discord: он определяет запущенную игру сам, без поддержки
# со стороны игры. Ничего ставить на свою машину не нужно — только Discord,
# который и так запущен.
#
# Чтобы заработало, нужно сделать три вещи один раз:
#   1. вступить в сервер Lanyard — https://discord.gg/lanyard
#      (без этого его бот презенса не видит);
#   2. включить в Discord «Настройки — Активность — Отображать текущую
#      активность как статус»;
#   3. взять свой ID: включить режим разработчика в настройках Discord,
#      нажать по себе правой кнопкой — «Копировать ID».
# Проверить: https://api.lanyard.rest/v1/users/<этот id>
#
# Пустой — игры не из Steam не отслеживаются вовсе.
DISCORD_USER_ID=

# Игры не из Steam встают в список игр, а часы в них сервер считает сам.
# Сколько наиграно до этого, не отдаёт ни одно API — стартовые часы можно
# вписать руками, например с tracker.gg: VALORANT=512;Other Game=10
DISCORD_GAME_HOURS=

# Программы, которые Discord считает «игрой», но в списке им не место.
# Пустое значение — берётся список по умолчанию из application.yaml
# (IDE, плееры, OBS). Через запятую.
# DISCORD_IGNORE=

# --- Только для сервера (docker compose up) ---------------------------

# Имена, на которые Caddy выпустит сертификаты Let's Encrypt. Через запятую,
# сколько угодно: на каждое берётся свой сертификат. A-запись каждого имени
# должна указывать на IP сервера, иначе его сертификат не выдадут.
# www уводится на апекс автоматически, отдельно настраивать не нужно.
SITE_DOMAINS=gna1zel.online, www.gna1zel.online
# Почта для Let's Encrypt: туда придёт письмо, если сертификат перестанет
# продлеваться. Можно оставить пустой — сертификат выпустится и так,
# просто предупреждений не будет.
ACME_EMAIL=

# Пароль postgres. Локально хватает postgres, на сервере поставь длинный
# случайный: openssl rand -base64 24
POSTGRES_PASSWORD=postgres
